# Salin file ini jadi ".env" (tanpa .example) lalu isi nilainya.
# JANGAN commit file ".env" ke git — sudah masuk .gitignore, biarkan begitu.

# Port server (opsional, default 3000 kalau tidak diisi)
PORT=3000

# URL publik server ini, dipakai untuk self-ping keep-alive (lihat README bagian Keep-Alive)
# Contoh: SELF_URL=https://nama-app-kamu.onrender.com
SELF_URL=

# Kredensial pengirim email untuk fitur "Lupa Password" (kode reset 6 digit)
# EMAIL_USER = alamat Gmail pengirim
# EMAIL_APP_PASSWORD = App Password 16 karakter dari Google (BUKAN password akun Gmail biasa)
# Cara buat: myaccount.google.com/apppasswords (2-Step Verification harus aktif dulu)
EMAIL_USER=xyzfarx995775@gmail.com
EMAIL_APP_PASSWORD=
